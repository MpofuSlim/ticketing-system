# =============================================================================
# loans-service SECRET TEMPLATE — copy to deploy/cells/loans.<iso>.local.env
# =============================================================================
#
# The keys the Secret `loans-service-secrets` may carry. It is the loans pod's
# ONLY envFrom source (deploy/k8s/loans/loans-service.yaml): loans never takes
# cell-zw / cell-zw-secrets whole — only the few keys its Deployment names —
# because Spring binds env vars onto properties by name and the cell's
# JWT_SECRET, BOOTSTRAP_ADMIN_PASSWORD and SPRING_PROFILES_ACTIVE would land on
# loans' own. For the same reason, NONE of
# these keys ever goes into cell.<iso>.env or cell.<iso>.local.env: every fleet
# pod receives those, and the INNBUCKS_* credentials below book loans that
# InnBucks pays out.
#
# This file is committed and holds NO values. The real one is created on the
# host only (deploy/cells/*.local.env is gitignored), chmod 600:
#   cp deploy/cells/loans.example.env deploy/cells/loans.zw.local.env
# and loaded as in deploy/k8s/README.md ("loans-service"):
#   kubectl -n ticketing create secret generic loans-service-secrets \
#     --from-env-file=deploy/cells/loans.zw.local.env --dry-run=client -o yaml | kubectl apply -f -
#
# Format: KEY=value, one per line, no quotes and no trailing comment
# (--from-env-file keeps everything after the `=`). Lines starting with # are
# skipped. A key written as `KEY=` with nothing after it is NOT the same as
# leaving it out: it is set, to an empty string, and replaces the packaged
# default. So every optional key below is commented out; uncomment only the
# ones this host sets.
#
# ONLY the keys listed below belong in this file — never a SPRING_*, SERVER_*,
# DB_* or JAVA_* key. The port, the database, the profile, the country, the
# edge prefix and the WhatsApp gateway URL are explicit `env:` entries in the
# Deployment, but an explicit entry wins over this Secret for the SAME key only:
# Spring reaches one property through several names, so SPRING_DATASOURCE_URL
# here would repoint loans at another database (as the cell postgres
# superuser), and a profile line such as SPRING_PROFILES_GROUP_API=scheduled-tasks
# would switch on the jobs that pay out and lodge deductions.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
# loans' OWN token-signing key (HS256, at least 32 bytes). Generate it with
# `openssl rand -base64 48`. NEVER the fleet's JWT_SECRET: a holder of a shared
# key can mint tokens for both systems. Loans refuses to boot without one.
JWT_SECRET=

# Password of the loans SUPER_ADMIN `admin`, created on the first boot against
# an empty loans_service database (loans' own, never the fleet's). Read only
# while no `admin` user exists; clear it after the first boot, as the fleet
# does with its own.
BOOTSTRAP_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Optional — left out, the feature is off (or keeps its packaged default)
# -----------------------------------------------------------------------------
# InnBucks: loan booking and the payout deposit. The API's manual disbursement
# calls InnBucks too, so these are live even with the scheduled jobs off.
# INNBUCKS_API_KEY=
# INNBUCKS_USERNAME=
# INNBUCKS_PASSWORD=
# Packaged default: https://staging.innbucks.co.zw. Set only to change it.
# INNBUCKS_BASE_URL=
# The InnBucks loan product bookings are made against. Packaged default: NANOUS.
# INNBUCKS_LOAN_PRODUCT=

# SuperApp borrower sign-in (Staff Grocery Loan). The InnBucks middleware signs
# a short-lived assertion that the SuperApp user just entered their PIN, and
# loans trades it for a borrower session. This is the middleware's PUBLIC key
# (PEM written on ONE line with its line breaks as \n, or the bare base64 of
# the X.509 encoding); loans can verify with it, never mint. Left out, nobody
# can sign in: /lending/v1/auth/exchange answers 503 and nothing else is
# affected. The previous key is accepted beside it during a rotation.
# BORROWER_ASSERTION_PUBLIC_KEY=
# BORROWER_ASSERTION_PREVIOUS_PUBLIC_KEY=
# STAGING ONLY, until the middleware signs: loans signs assertions itself, for
# ANY phone, to whoever sends the api key (at least 32 characters, e.g.
# `openssl rand -base64 48`) to /lending/v1/auth/test-assertions. Whoever holds
# it can sign in and borrow as any staff member, so NEVER set these where real
# money moves. The private key is RSA in PKCS#8, on one line like the public
# key above. Enabled without both, loans refuses to start.
# BORROWER_TEST_ASSERTIONS_ENABLED=
# BORROWER_TEST_ASSERTIONS_API_KEY=
# BORROWER_TEST_ASSERTIONS_PRIVATE_KEY=

# Ndasenda payroll deductions. Used by the lodgement/commit/response jobs,
# which stay off in the cell until their own go-live step.
# NDASENDA_USERNAME=
# NDASENDA_PASSWORD=
# NDASENDA_SECURITY_CODE=
# NDASENDA_DEDUCTION_CODE=

# InnBucks notification API (SMS, and email where the cell has no SES). The
# platform API the fleet sends through; the cell holds its values as
# BANK_API_URL / _KEY / _USERNAME / _PASSWORD. Without them every loans SMS
# fails and is logged, and so does email unless it goes over SES.
# INNBUCKS_NOTIFY_URL=
# INNBUCKS_NOTIFY_API_KEY=
# INNBUCKS_NOTIFY_USERNAME=
# INNBUCKS_NOTIFY_PASSWORD=

# Email, as user-service sends Foundry's: the InnBucks branded HTML, over the
# cell's SES when the host has it on (the Deployment reads the cell's MAIL_*
# keys, never put them here), else through the notification API above. The
# name the inbox shows, packaged default "InnBucks Lending" (never the cell's
# MAIL_SENDER_NAME); plain text with the InnBucks footer instead of HTML (true);
# a hosted logo image (blank draws it in CSS).
# LOANS_MAIL_SENDER_NAME=
# INNBUCKS_NOTIFY_HTML_ENABLED=
# INNBUCKS_NOTIFY_LOGO_URL=

# WhatsApp gateway key (the URL comes from the cell, see the Deployment). The
# FIRST channel for every Staff Grocery Loan message (offers, the launch,
# vouchers) and for a portal user's temporary password, each falling back to
# SMS; left out, they all go by SMS.
# WHATSAPP_API_KEY=

# Where portal users sign in, e.g. https://lending.innbucks.co.zw: the link in
# the message that gives someone a temporary password (a new account, a reset).
# Not a secret, but loans' own. SMS carries it only as a bare host (the gateway
# refuses : and /); WhatsApp and email carry it whole. Left out, the message
# names InnBucks Lending without a link.
# LOANS_PORTAL_SIGN_IN_URL=

# Staff Grocery Loan voucher codes. Set both or neither: with neither, every
# voucher endpoint answers 503 and nothing else is affected; with one, or a
# malformed one, loans refuses to start. Generate each with
# `openssl rand -base64 32`, both different. The HMAC key finds a voucher by the
# code a till sends: NEVER change it while vouchers are open, or their codes stop
# being found. The encryption key (base64 of exactly 32 bytes) seals the code so
# it can be sent again and shown to VOUCHER_SUPPORT staff.
# VOUCHER_CODE_HMAC_KEY=
# VOUCHER_CODE_ENCRYPTION_KEY=
# Voucher rules, packaged defaults in brackets: code length (16), market days a
# voucher stays good (30), partial redemption (true), delivery order (WHATSAPP,SMS).
# VOUCHER_CODE_LENGTH=
# VOUCHER_VALIDITY_DAYS=
# VOUCHER_PARTIAL_REDEMPTION_ALLOWED=
# VOUCHER_DELIVERY_CHANNELS=

# Staff Grocery Loan terms, packaged defaults in brackets. The open business
# questions are settings with the working answer as default: the least a
# borrower may take (10.00) and the steps below the full offer (5.00; the least
# must be a multiple of it), OQ-03; the day of the following month a loan is due
# (20, the salary day; at most 28), OQ-02; days past due before arrears (0); and
# what an unspent voucher leaves owed (DEBT_STANDS or REDUCED_TO_AMOUNT_SPENT),
# OQ-09.
# STAFF_LOANS_MINIMUM_DRAW=
# STAFF_LOANS_DRAW_INCREMENT=
# STAFF_LOANS_REPAYMENT_DAY=
# STAFF_LOANS_ARREARS_GRACE_DAYS=
# STAFF_LOANS_UNREDEEMED_VOUCHER_TREATMENT=
# Payroll's mailboxes, comma-separated: emailed with Human Capital when a
# borrower leaves owing a paid-out Staff Grocery Loan, so it is recovered from
# their terminal benefits. Left out, Human Capital alone is told.
# STAFF_LOANS_PAYROLL_EMAILS=

# INNBUCKS_GATEWAY_URL is no longer read: loans' SMS used to post to the InnBucks
# core gateway adapter, a retired host, and now goes through the notification
# API above. Loans' anonymous forgot-password stays edge-denied at the gateway
# all the same (see the loans-forgot-password-deny route).
#
# Every other loans setting (JWT_EXPIRATION_MS, ACCOUNT_LOCKOUT_*, DOCUMENT_*,
# HTTP_CLIENT_*_MS, ...) keeps its packaged default; add it here only to change
# it.
