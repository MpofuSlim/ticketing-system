# =============================================================================
# Cell: ZW (Zimbabwe) — current home market, single active deployment today.
# =============================================================================
# Committed defaults only. Secrets live in deploy/cells/cell.zw.local.env on
# the host (gitignored); the deploy script layers it on top of this file via
# `docker compose --env-file cell.zw.env --env-file cell.zw.local.env up -d`.
# See deploy/README.md for the full provisioning workflow.
#
# To stand up a second cell (e.g. Kenya):
#   cp deploy/cells/cell.example.env deploy/cells/cell.ke.env
#   # edit ~6 values, then on the host create cell.ke.local.env with secrets
#   deploy/cell.sh ke up
# =============================================================================

# -- Cell identity -----------------------------------------------------------
INNBUCKS_COUNTRY=ZW

# -- Settlement currency (ISO 4217) ------------------------------------------
INNBUCKS_CURRENCY=USD

# -- Edge routing: cell registry (step 7) ------------------------------------
# {ISO -> public api-gateway base URL}, consumed by user-service for
# /cells/lookup and 409 wrong_cell redirects. Today ZW is the only live cell,
# so it maps to itself (lets the app confirm a ZW customer's home base URL).
# Add an entry — and redeploy this + every other cell with the SAME map — when
# a new market (e.g. KE) goes live. dtx.innbucks.co.zw is the ZW gateway origin
# (where /brand/** is already served); adjust if the public host differs.
INNBUCKS_CELLS_REGISTRY={"ZW":"https://dtx.innbucks.co.zw"}

# -- Public edge path prefix -------------------------------------------------
# dtx.innbucks.co.zw hosts multiple systems, each under a path prefix; ours is
# mounted at /foundry. nginx STRIPS the prefix before proxying to the gateway
# (routes and services never see it), so this is consumed ONLY by springdoc:
# the gateway's swagger config-url/urls and each service's OpenAPI `servers`
# entry must carry the prefix because the browser resolves them against the
# public origin. Do NOT have the edge send X-Forwarded-Prefix instead — the
# gateway applies that header to route matching and every route 404s.
# Leave empty when the edge serves the gateway at the domain root.
PUBLIC_API_PREFIX=/foundry

# -- Image registry ----------------------------------------------------------
# Override IMAGE_TAG per-deploy on the command line (e.g. sha-<commit>);
# `latest` is the default for convenience but not what a prod release pins.
GHCR_OWNER=mpofuslim
IMAGE_TAG=latest

# -- Spring runtime profile --------------------------------------------------
SPRING_PROFILES_ACTIVE=prod,json

# -- CORS --------------------------------------------------------------------
# Zimbabwe FE origins. The production frontends are served from the
# innbucks.co.zw subdomains below; the legacy Vercel preview origins were
# dropped when the FE moved off Vercel.
CORS_ALLOWED_ORIGINS=https://ticketize.innbucks.co.zw,https://foundry.innbucks.co.zw

# -- Postgres ----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME_in_cell.zw.local.env

# -- Redis -------------------------------------------------------------------
REDIS_PASSWORD=REPLACE_ME_in_cell.zw.local.env

# -- Eureka registry auth ----------------------------------------------------
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=REPLACE_ME_in_cell.zw.local.env

# -- JWT signing -------------------------------------------------------------
JWT_SECRET=REPLACE_ME_in_cell.zw.local.env

# -- Inter-service shared secrets --------------------------------------------
INTERNAL_API_TOKEN=REPLACE_ME_in_cell.zw.local.env

# -- Loyalty signing secrets -------------------------------------------------
LOYALTY_VOUCHER_SECRET=REPLACE_ME_in_cell.zw.local.env
LOYALTY_QR_SECRET=REPLACE_ME_in_cell.zw.local.env

# -- Loyalty TEST-ONLY public endpoints --------------------------------------
# Enables /loyalty/public/** (PublicTestController): UNAUTHENTICATED reads of a
# customer's points statement, keyed by phone number, so a frontend can be built
# against real data before its auth flow exists.
#
# Committed as FALSE on purpose, and it must stay false here. This file is the
# cell-wide ConfigMap and is shared by BOTH ZW hosts — the staging box and the
# production box — so flipping it here would open customer transaction history
# to anyone who can guess a phone number ON PRODUCTION, not just on staging.
#
# To enable it on staging only, set it in that host's gitignored
# deploy/cells/cell.zw.local.env:
#     LOYALTY_PUBLIC_TEST_ENABLED=true
# k8s layers `envFrom: [configMapRef: cell-zw, secretRef: cell-zw-secrets]` and
# the LATER source wins on a duplicate key, so the per-host Secret overrides
# this default. loyalty-service logs a boot WARN whenever it comes up enabled.
LOYALTY_PUBLIC_TEST_ENABLED=false

# -- First-run admin bootstrap (one-time; clear after first deploy) ----------
BOOTSTRAP_ADMIN_PASSWORD=

# -- WhatsApp gateway --------------------------------------------------------
# wasenda.innbucks.co.zw is the production ZW WhatsApp gateway.
WHATSAPP_GATEWAY_URL=https://wasenda.innbucks.co.zw
WHATSAPP_API_KEY=REPLACE_ME_in_cell.zw.local.env

# -- InnBucks core gateway adapter -------------------------------------------
# Current host-resident jar on the ZW EC2 — adjust per cell's network layout.
INNBUCKS_GATEWAY_URL=http://10.0.155.69:8088

# -- ZimSwitch Online (COPYandPAY) — the CARD rail ---------------------------
# The second collection rail on POST /payments, beside the InnBucks 2D code
# (which stays the default). Spec: docs/api/zimswitch-copyandpay.md.
#
# These keys MUST live here, not only in the secret file: this file becomes the
# `cell-zw` ConfigMap (`--from-env-file`), and payment-service reads its whole
# environment from `envFrom: [configMapRef: cell-zw, secretRef: cell-zw-secrets]`.
# A key absent from BOTH never reaches the pod. Omitting the block is what left
# the ZW cell HALF-PROVISIONED — credentials arrived via the secret file, so the
# rail looked live, but ZIMSWITCH_SHOPPER_RESULT_URL had no source and every
# card checkout was refused 503.
#
# ENTITY_ID / ACCESS_TOKEN are deliberately BLANK here, not REPLACE_ME
# placeholders like the secrets above. Blank is the rail's fail-SAFE: it
# disables card payments cleanly (503 at the gate, InnBucks code rail
# unaffected). A literal "REPLACE_ME..." string is non-blank, so the rail would
# consider itself configured and every checkout would instead fail at the
# gateway. The real values come from cell.zw.local.env — secretRef is listed
# after configMapRef in envFrom, so the secret's value wins over the blank.
ZIMSWITCH_BASE_URL=https://eu-test.oppwa.com
ZIMSWITCH_ENTITY_ID=
ZIMSWITCH_ACCESS_TOKEN=
# EXTERNAL on the ZimSwitch test entity; blank in production (the parameter is
# then omitted from the request entirely rather than sent empty).
ZIMSWITCH_TEST_MODE=EXTERNAL
# The `data-brands` value the FE puts on the widget form. VISA MASTER works on
# the test gateway; the Private-label brand code for this merchant is still
# pending from ZimSwitch. The FE reads this from the payment response, so
# correcting it is a config change with NO frontend deploy.
ZIMSWITCH_BRANDS=VISA MASTER
# Absolute http(s) URL of the FE's card-result page. It becomes the widget
# form's action and, for async brands (3-D Secure), the gateway's redirect
# target — a relative path will NOT work. Must be the origin the checkout page
# is actually served from (see CORS_ALLOWED_ORIGINS above); a cell whose FE
# lives on a different host needs its own value here.
# Blank or malformed = the rail refuses to START a checkout (503) rather than
# minting a real one the FE cannot render, which would hold the order's single
# payment slot across BOTH rails for ~28 minutes.
ZIMSWITCH_SHOPPER_RESULT_URL=https://ticketize.innbucks.co.zw/checkout/card-result

# -- EcoCash Instant Payment (EIP) — the wallet rail (paymentRail=ECOCASH) ---
# Spec: docs/api/ecocash-eip.md. Same discipline as the ZimSwitch block above:
# every key the rail reads MUST have a source here or in the secret file, and
# the credentials are deliberately BLANK (blank fails SAFE — the rail refuses
# charges with a clean 503; the other rails are unaffected). The real values
# (ECOCASH_API_USERNAME/PASSWORD, ECOCASH_MERCHANT_CODE/NUMBER/PIN) come from
# cell.zw.local.env — the secretRef wins over these blanks.
ECOCASH_BASE_URL=https://payonline.ecocash.co.zw/ecocashGateway-preprod
ECOCASH_API_USERNAME=
ECOCASH_API_PASSWORD=
ECOCASH_MERCHANT_CODE=
ECOCASH_MERCHANT_NUMBER=
ECOCASH_MERCHANT_PIN=
# OUR public webhook EcoCash POSTs charge outcomes to. Must be the ABSOLUTE
# public edge URL WITH the /foundry prefix — EcoCash fetches from the public
# internet, where nginx strips the prefix before proxying (the same trap that
# broke the WhatsApp QR media fetch). This file is shared by BOTH ZW boxes:
# the value below is PRODUCTION's; the staging box overrides it in its
# gitignored cell.zw.local.env (the Secret wins over the ConfigMap), exactly
# like LOYALTY_PUBLIC_TEST_ENABLED.
# Blank or relative = the rail refuses to START a charge (503, half-provisioned
# boot ERROR) rather than issuing charges whose outcome only the poller ever
# learns about.
ECOCASH_NOTIFY_URL=https://dtx.innbucks.co.zw/foundry/payments/ecocash/notify

# -- Stuck-payment operator alerts -------------------------------------------
# Inbox for the one-time "paid but unconfirmable, needs manual confirmation"
# escalation from payment-service's reconciler. Blank = operator email off
# (the customer WhatsApp reassurance and the still_failing metric remain).
OPERATOR_ALERT_EMAIL=

# -- Gateway rate limiting ---------------------------------------------------
RATE_LIMIT_REPLENISH_PER_SECOND=50
RATE_LIMIT_BURST_CAPACITY=100

# -- Tracing -----------------------------------------------------------------
TRACING_ENABLED=false
OTLP_ENDPOINT=http://localhost:4318/v1/traces

# -- Email transport (Amazon SES over SMTP) -----------------------------------
# Off by default: with MAIL_ENABLED unset, email keeps going through the
# InnBucks notification API exactly as before. Set these to send our own mail,
# which is the only way to control the From display name — the shared
# notification API stamps its own ("Online Banking") on every product's email.
#   MAIL_HOST     email-smtp.<region>.amazonaws.com
#   MAIL_FROM     must be an SES-VERIFIED identity in that region
#   MAIL_SENDER_NAME  what the recipient sees, e.g. Foundry
# MAIL_USERNAME / MAIL_PASSWORD are SES SMTP credentials -> cell.zw.local.env
# (the secret file), NEVER here.
MAIL_ENABLED=false
MAIL_HOST=email-smtp.eu-west-1.amazonaws.com
MAIL_PORT=587
MAIL_FROM=banking@innbucks.co.zw
MAIL_SENDER_NAME=Foundry
